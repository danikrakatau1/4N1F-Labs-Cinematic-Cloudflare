{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4n1f-labs-cinematic-cloudflare",
  "account_id": "69b3344647228e4e7c1c85f7a5136f23",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-09-06",
  "kv_namespaces": [
    {
      "binding": "PREVIEW_PACKAGES",
      "id": "f5d2286e18e8401aa40ec9d8591bf8b6"
    }
  ],
  "services": [
    {
      "binding": "KV_BACKEND",
      "service": "4n1f-kv-api"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/fetch*",
      "/p_*",
      "/editor/p_*"
    ]
  }
}
