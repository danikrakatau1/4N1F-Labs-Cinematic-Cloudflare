{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4n1f-labs-cinematic-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/fetch*",
      "/p_*",
      "/editor/p_*"
    ]
  }
}
